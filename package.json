{
  "name": "behavior-data-labeler",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "start": "npm run desktop",
    "desktop": "npm run build && node scripts/launch.cjs",
    "build": "vite build",
    "test": "node --test",
    "package:mac": "npm run build && electron-builder --mac",
    "package:win": "npm run build && electron-builder --win",
    "test:desktop": "npm run build && node scripts/launch.cjs scripts/desktop-smoke.cjs"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.0.12",
    "vite": "^7.1.1"
  },
  "build": {
    "appId": "org.dogtonomous.behaviorlabeler",
    "productName": "Behavior Data Labeler",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "src/model.js",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**/*",
      "node_modules/ffprobe-static/**/*"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.video",
      "identity": null
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "directories": {
      "output": "release"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
